RewriteEngine On

# If the request maps to a real file or directory, serve it normally.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Clean home/staff routes served by index.php.
RewriteRule ^(hjem|staff)/?$ index.php [L]

# Remove index.php from visible URLs.
RewriteRule ^index\.php$ / [R=301,L]
